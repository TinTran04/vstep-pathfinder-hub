# ============================================================
# VSTEPPro Frontend — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in the values.
#
# VITE_DATA_SOURCE:
#   "mock" — dùng localStorage mock data (default, không cần backend)
#   "api"  — dùng backend API thật (cần VITE_API_BASE_URL)
#
# VITE_API_BASE_URL:
#   URL gốc của backend API (chỉ cần thiết khi VITE_DATA_SOURCE=api)
# ============================================================

VITE_DATA_SOURCE=mock
VITE_API_BASE_URL=http://localhost:4000/api/v1
